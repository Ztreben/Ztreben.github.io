<article class="article">
  <header class="article-header">
    <h1 class="article-title"><%= page.title %></h1>
    <div class="article-meta">
      <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD HH:mm') %></time>
    </div>
  </header>
  <div class="article-entry">
    <%- page.content %>
  </div>
  <footer class="article-footer">
    <div class="share">
      <a href="javascript:;" class="article-share-link" data-url="<%= config.url %>/<%= page.path %>" data-id="<%= page._id %>" data-title="<%= page.title %>">分享</a>
    </div>
  </footer>
</article>