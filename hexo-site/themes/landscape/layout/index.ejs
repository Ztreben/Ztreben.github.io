<section class="posts">
  <% if (site.posts && site.posts.length) { %>
    <% site.posts.sort('date', -1).forEach(function(post){ %>
      <article class="post-item">
        <h2 class="post-title"><a href="<%= url_for(post.path) %>"><%= post.title %></a></h2>
        <div class="post-meta"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time></div>
        <div class="post-excerpt"><%- truncate(strip_html(post.content), {length: 160}) %></div>
        <a class="read-more" href="<%= url_for(post.path) %>">阅读全文 →</a>
      </article>
    <% }); %>
  <% } else { %>
    <p>暂无文章，敬请期待。</p>
  <% } %>
</section>